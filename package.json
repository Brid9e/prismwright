{
  "name": "prismwright",
  "private": true,
  "version": "0.1.0",
  "description": "Prismwright（棱匠）— 本地优先的开源卡牌系列编辑器",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/Brid9e/prismwright.git" },
  "homepage": "https://github.com/Brid9e/prismwright",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "verify:renderer": "pnpm -F @prismwright/renderer test && pnpm -F @prismwright/renderer typecheck && pnpm -F @prismwright/renderer build",
    "verify:editor": "pnpm -F @prismwright/desktop test && pnpm -F @prismwright/desktop typecheck && pnpm -F @prismwright/desktop build",
    "dev": "pnpm -F @prismwright/desktop tauri dev",
    "dev:web": "pnpm -F @prismwright/desktop dev",
    "build": "pnpm -r build"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0"
  },
  "type": "module"
}
